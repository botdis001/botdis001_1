const { SlashCommandBuilder, EmbedBuilder } = require('discord.js');

// รายชื่อจังหวัดและพิกัดตัวอย่างทั่วไทย
const thailandLocations = [
    { name: 'กรุงเทพมหานคร (Bangkok)', lat: 13.7563, lon: 100.5018 },
    { name: 'เชียงใหม่ (Chiang Mai)', lat: 18.7883, lon: 98.9853 },
    { name: 'สกลนคร (Sakon Nakhon)', lat: 17.1661, lon: 104.1480 },
    { name: 'ภูเก็ต (Phuket)', lat: 7.8804, lon: 98.3923 },
    { name: 'ขอนแก่น (Khon Kaen)', lat: 16.4322, lon: 102.8236 },
    { name: 'ชลบุรี (Chon Buri)', lat: 13.3611, lon: 100.9847 },
    { name: 'นครราชสีมา (Nakhon Ratchasima)', lat: 14.9799, lon: 102.0977 },
    { name: 'สงขลา (Songkhla)', lat: 7.1988, lon: 100.5955 },
    { name: 'เชียงราย (Chiang Rai)', lat: 19.9105, lon: 99.8406 },
    { name: 'นนทบุรี (Nonthaburi)', lat: 13.8591, lon: 100.5217 },
    { name: 'สมุทรปราการ (Samut Prakan)', lat: 13.5991, lon: 100.5998 },
    { name: 'อุบลราชธานี (Ubon Ratchathani)', lat: 15.2289, lon: 104.8563 },
    { name: 'หาดใหญ่ (Hat Yai, Songkhla)', lat: 7.0084, lon: 100.4747 },
    { name: 'พัทยา (Pattaya, Chon Buri)', lat: 12.9236, lon: 100.8825 }
];

module.exports = {
    data: new SlashCommandBuilder()
        .setName('weather')
        .setDescription('ตรวจสอบสภาพอากาศในประเทศไทย พร้อมระบบค้นหาอัจฉริยะ')
        .addStringOption(option =>
            option.setName('location')
                .setDescription('พิมพ์ชื่อจังหวัดหรืออำเภอ (พิมพ์ผิดนิดหน่อยระบบก็ช่วยหาให้)')
                .setRequired(true)
                .setAutocomplete(true)),

    async autocomplete(interaction) {
        const focusedValue = interaction.options.getFocused().toLowerCase();
        const filtered = thailandLocations.filter(loc => 
            loc.name.toLowerCase().includes(focusedValue) || 
            matchingScore(loc.name.toLowerCase(), focusedValue)
        ).slice(0, 25);

        await interaction.respond(
            filtered.map(item => ({ name: item.name, value: item.name }))
        );
    },

    async execute(interaction) {
        await interaction.deferReply({ ephemeral: true });

        const locationName = interaction.options.getString('location');
        const foundLoc = thailandLocations.find(loc => loc.name.toLowerCase() === locationName.toLowerCase()) || 
                         thailandLocations.find(loc => loc.name.toLowerCase().includes(locationName.toLowerCase()));

        if (!foundLoc) {
            return interaction.editReply({ content: `❌ ไม่พบข้อมูลสถานที่ "${locationName}" กรุณาเลือกจากรายการที่ระบบแนะนำ` });
        }

        try {
            const weatherRes = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${foundLoc.lat}&longitude=${foundLoc.lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m`);
            const weatherData = await weatherRes.json();

            const current = weatherData.current;
            const embed = new EmbedBuilder()
                .setTitle(`🌤️ สภาพอากาศ ณ ${foundLoc.name}`)
                .setColor('#0099ff')
                .addFields(
                    { name: '🌡️ อุณหภูมิปัจจุบัน', value: `${current.temperature_2m}°C`, inline: true },
                    { name: '🌡️ รู้สึกเหมือน', value: `${current.apparent_temperature}°C`, inline: true },
                    { name: '💧 ความชื้น', value: `${current.relative_humidity_2m}%`, inline: true },
                    { name: '🌧️ ปริมาณฝน', value: `${current.precipitation} มม.`, inline: true },
                    { name: '💨 ความเร็วลม', value: `${current.wind_speed_10m} กม./ชม.`, inline: true }
                )
                .setTimestamp()
                .setFooter({ text: 'ระบบตรวจสอบสภาพอากาศอัตโนมัติ' });

            await interaction.user.send({ content: `📬 ผลการตรวจสอบสภาพอากาศที่คุณขอครับ:`, embeds: [embed] });
            await interaction.editReply({ content: `✅ ระบบได้จัดส่งข้อมูลสภาพอากาศของ **${foundLoc.name}** ไปยังข้อความส่วนตัว (DM) ของคุณเรียบร้อยแล้วครับ!` });

        } catch (error) {
            console.error('Weather API Error:', error);
            await interaction.editReply({ content: '❌ เกิดข้อผิดพลาดในการดึงข้อมูลสภาพอากาศ กรุณาลองใหม่อีกครั้งในภายหลัง' });
        }
    }
};

function strMatch(str, query) {
    let matches = 0;
    for (let char of query) {
        if (str.includes(char)) matches++;
    }
    return matches >= Math.ceil(query.length / 2);
}

function matchingScore(target, query) {
    if (!query) return true;
    return target.includes(query) || strMatch(target, query);
}
